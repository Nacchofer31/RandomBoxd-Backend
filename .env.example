# Application
APP_NAME=RandomBoxd Backend
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://randomboxd:randomboxd@localhost:5432/randomboxd
POSTGRES_USER=randomboxd
POSTGRES_PASSWORD=randomboxd
POSTGRES_DB=randomboxd

# LLM / AI
OPENAI_API_KEY=sk-your-key-here
LLM_PROVIDER=openai  # openai | ollama
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Logging
LOG_LEVEL=INFO
